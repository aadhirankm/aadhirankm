{
  "name": "veeran",
  "private": true,
  "version": "0.1.0",
  "description": "Veeran - Silambam Competition Management",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm run build",
    "start": "npm --prefix server start"
  },
  "dependencies": {
  "react": "^18.2.0",
  "react-dom": "^18.2.0",
  "build": "react-scripts build",
  "react-scripts": "5.0.1"
},
  "scripts": {
  "start": "react-scripts start",
  "build": "react-scripts build",
  "test": "react-scripts test"
},
"engines": {
  "node": ">=18"
}

}
